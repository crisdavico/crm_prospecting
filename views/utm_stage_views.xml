<odoo>
    <record id="utm_stage_view_list" model="ir.ui.view">
        <field name="name">utm.stage.view.list.prospecting</field>
        <field name="model">utm.stage</field>
        <field name="inherit_id" ref="utm.utm_stage_view_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="prospecting_enabled" />
            </field>
        </field>
    </record>

    <record id="utm_stage_view_form" model="ir.ui.view">
        <field name="name">utm.stage.view.form.prospecting</field>
        <field name="model">utm.stage</field>
        <field name="inherit_id" ref="utm.utm_stage_view_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="prospecting_enabled" />
            </field>
        </field>
    </record>
</odoo>
