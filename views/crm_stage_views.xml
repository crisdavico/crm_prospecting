<odoo>
    <record id="crm_stage_view_list" model="ir.ui.view">
        <field name="name">crm.stage.view.list.prospecting</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_tree" />
        <field name="arch" type="xml">
            <field name="is_won" position="after">
                <field name="prospecting_contacted" optional="show" />
            </field>
        </field>
    </record>

    <record id="crm_stage_view_form" model="ir.ui.view">
        <field name="name">crm.stage.view.form.prospecting</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form" />
        <field name="arch" type="xml">
            <field name="is_won" position="after">
                <field name="prospecting_contacted" invisible="is_won" />
            </field>
        </field>
    </record>
</odoo>
